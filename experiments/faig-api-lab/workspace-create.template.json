{
  "description": "Template: replace name and workspace administrator ID before use",
  "variables": {
    "workspace_admin_id": "REPLACE-ADMIN-UUID"
  },
  "resources": [
    {
      "name": "provider",
      "kind": "provider",
      "operation": "existing",
      "lookup": "slug-litellm"
    },
    {
      "name": "policy",
      "kind": "policy",
      "operation": "existing",
      "lookup": "default-policy"
    },
    {
      "name": "workspace",
      "kind": "workspace",
      "operation": "create",
      "lookup": "REPLACE-workspace-name",
      "body": {
        "workspaceName": "REPLACE-workspace-name",
        "admins": [
          {
            "id": {
              "$var": "workspace_admin_id"
            }
          }
        ],
        "description": "Experimental workspace",
        "budget": null,
        "budgetCycle": "monthly",
        "policyIds": [
          {
            "id": {
              "$ref": "policy.id"
            }
          }
        ],
        "providerAccess": [
          {
            "providerId": {
              "$ref": "provider.providerId"
            },
            "platform": {
              "$ref": "provider.platform"
            },
            "name": {
              "$ref": "provider.name"
            },
            "allModels": true,
            "models": [],
            "blockedModelUuids": [],
            "allKeys": true,
            "keys": [],
            "excludedKeyIds": []
          }
        ],
        "modelGroups": [],
        "defaultKeyBindings": [
          {
            "providerId": {
              "$ref": "provider.providerId"
            },
            "keyIds": [
              {
                "$ref": "provider.apiKeys.0.id"
              }
            ]
          }
        ]
      },
      "checks": [
        {
          "field": "workspaceName",
          "equals": "REPLACE-workspace-name"
        }
      ]
    }
  ]
}
