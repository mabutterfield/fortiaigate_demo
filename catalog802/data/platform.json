{
  "schema_version": 1,
  "faig_version": "8.0.2",
  "currency": "USD",
  "unit": "per_1m_tokens",
  "naming": {
    "workspace": "{student}_workspace",
    "project": "{student}_{scenario}",
    "key": "{student}_{scenario}_{action}",
    "policy": "{student}_{scenario}_{action}_policy",
    "guardrail": "{student}_{scenario}_{action}_guardrail",
    "detector": "{student}_{detector}",
    "passthrough_key": "{student}_passthrough"
  },
  "hello_world": {
    "prompt": "Reply with exactly: Hello.",
    "expect": {
      "verdict": "log",
      "evidence_present": [],
      "evidence_absent": [
        "sensitive-data-in-reply",
        "block-message-in-reply"
      ]
    }
  },
  "detectors": {
    "identity-dob-alert": {
      "kind": "dlp",
      "disposition": "alert",
      "categories": [
        "Date of birth"
      ],
      "description": "Alert on Date of birth"
    },
    "identity-ssn-alert": {
      "kind": "dlp",
      "disposition": "alert",
      "categories": [
        "SSN"
      ],
      "description": "Alert on SSN"
    },
    "payment-card-alert": {
      "kind": "dlp",
      "disposition": "alert",
      "categories": [
        "Credit/debit card"
      ],
      "description": "Alert on Credit/debit card"
    },
    "identity-dob-redact": {
      "kind": "dlp",
      "disposition": "redact",
      "categories": [
        "Date of birth"
      ],
      "description": "Redact on Date of birth"
    },
    "identity-ssn-redact": {
      "kind": "dlp",
      "disposition": "redact",
      "categories": [
        "SSN"
      ],
      "description": "Redact on SSN"
    },
    "payment-card-redact": {
      "kind": "dlp",
      "disposition": "redact",
      "categories": [
        "Credit/debit card"
      ],
      "description": "Redact on Credit/debit card"
    },
    "identity-dob-block": {
      "kind": "dlp",
      "disposition": "block",
      "categories": [
        "Date of birth"
      ],
      "description": "Block on Date of birth"
    },
    "identity-ssn-block": {
      "kind": "dlp",
      "disposition": "block",
      "categories": [
        "SSN"
      ],
      "description": "Block on SSN"
    },
    "payment-card-block": {
      "kind": "dlp",
      "disposition": "block",
      "categories": [
        "Credit/debit card"
      ],
      "description": "Block on Credit/debit card"
    }
  },
  "guard_templates": {
    "output_dlp_alert": {
      "detectors": [
        "identity-dob-alert",
        "identity-ssn-alert",
        "payment-card-alert"
      ],
      "direction": "output",
      "deny_suspicious_characters": false
    },
    "output_dlp_redact": {
      "detectors": [
        "identity-dob-redact",
        "identity-ssn-redact",
        "payment-card-redact"
      ],
      "direction": "output",
      "deny_suspicious_characters": false
    },
    "output_dlp_block": {
      "detectors": [
        "identity-dob-block",
        "identity-ssn-block",
        "payment-card-block"
      ],
      "direction": "output",
      "deny_suspicious_characters": false
    }
  }
}
