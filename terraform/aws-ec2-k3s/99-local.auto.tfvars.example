# Optional EC2/k3s local overrides.
#
# Copy this file to 99-local.auto.tfvars only when you intentionally want to
# override tracked defaults from 00-system.auto.tfvars.

# instance_type = "g6.8xlarge"
# availability_zone = "us-east-1a"
#
# Use CIDR overrides only when the default lab networks overlap with your
# environment.
# vpc_cidr = "10.30.0.0/16"

# Optional instructor-owned files outside every Git checkout. Terraform stores
# the paths only; it does not read either file's contents.
# faig_admin_static_password_file = "/path/outside/git/admin-password"
# lab_student_password_file = "/path/outside/git/student-passwords"
