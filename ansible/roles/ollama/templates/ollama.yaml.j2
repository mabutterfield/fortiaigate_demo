---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ollama_namespace }}
  labels:
    app.kubernetes.io/name: {{ ollama_release_name }}
    app.kubernetes.io/part-of: fortiaigate-demo
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ ollama_release_name }}-models
  namespace: {{ ollama_namespace }}
  labels:
    app.kubernetes.io/name: {{ ollama_release_name }}
    app.kubernetes.io/part-of: fortiaigate-demo
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ ollama_storage_class | to_json }}
  resources:
    requests:
      storage: {{ ollama_storage_size | to_json }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ ollama_release_name }}
  namespace: {{ ollama_namespace }}
  labels:
    app.kubernetes.io/name: {{ ollama_release_name }}
    app.kubernetes.io/instance: {{ ollama_release_name }}
    app.kubernetes.io/part-of: fortiaigate-demo
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ ollama_release_name }}
      app.kubernetes.io/instance: {{ ollama_release_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ ollama_release_name }}
        app.kubernetes.io/instance: {{ ollama_release_name }}
        app.kubernetes.io/part-of: fortiaigate-demo
    spec:
{% if ollama_gpu_enabled | bool %}
      runtimeClassName: {{ ollama_runtime_class_name | to_json }}
{% endif %}
      containers:
        - name: ollama
          image: "{{ ollama_image_repository }}:{{ ollama_image_tag }}"
          imagePullPolicy: {{ ollama_image_pull_policy }}
          ports:
            - name: http
              containerPort: {{ ollama_container_port }}
          env:
            - name: OLLAMA_HOST
              value: "0.0.0.0:{{ ollama_container_port }}"
            - name: OLLAMA_MODELS
              value: /root/.ollama/models
            - name: OLLAMA_KEEP_ALIVE
              value: {{ ollama_keep_alive | to_json }}
            - name: OLLAMA_CONTEXT_LENGTH
              value: {{ ollama_context_length | string | to_json }}
{% if ollama_gpu_enabled | bool %}
            - name: NVIDIA_VISIBLE_DEVICES
              value: {{ ollama_gpu_uuids | join(',') | to_json }}
            - name: NVIDIA_DRIVER_CAPABILITIES
              value: compute,utility
{% endif %}
          readinessProbe:
            httpGet:
              path: /api/tags
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 30
          livenessProbe:
            httpGet:
              path: /api/tags
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
            failureThreshold: 6
          resources:
            requests:
              cpu: {{ ollama_cpu_request | to_json }}
              memory: {{ ollama_memory_request | to_json }}
            limits:
              cpu: {{ ollama_cpu_limit | to_json }}
              memory: {{ ollama_memory_limit | to_json }}
{% if ollama_gpu_enabled | bool and ollama_gpu_resource_request_enabled | bool %}
              nvidia.com/gpu: {{ ollama_gpu_count | int }}
{% endif %}
          volumeMounts:
            - name: models
              mountPath: /root/.ollama
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: {{ ollama_release_name }}-models
---
apiVersion: v1
kind: Service
metadata:
  name: {{ ollama_release_name }}
  namespace: {{ ollama_namespace }}
  labels:
    app.kubernetes.io/name: {{ ollama_release_name }}
    app.kubernetes.io/instance: {{ ollama_release_name }}
    app.kubernetes.io/part-of: fortiaigate-demo
spec:
  type: {{ ollama_service_type }}
  selector:
    app.kubernetes.io/name: {{ ollama_release_name }}
    app.kubernetes.io/instance: {{ ollama_release_name }}
  ports:
    - name: http
      port: {{ ollama_service_port }}
      targetPort: http
{% if ollama_service_type == "NodePort" and ollama_node_port | default('', true) | string | length > 0 %}
      nodePort: {{ ollama_node_port | int }}
{% endif %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ ollama_model_pull_job_name }}
  namespace: {{ ollama_namespace }}
  labels:
    app.kubernetes.io/name: {{ ollama_release_name }}
    app.kubernetes.io/instance: {{ ollama_release_name }}
    app.kubernetes.io/part-of: fortiaigate-demo
spec:
  backoffLimit: {{ ollama_model_pull_job_backoff_limit }}
  activeDeadlineSeconds: {{ ollama_model_pull_job_active_deadline_seconds }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ ollama_release_name }}-model-pull
        app.kubernetes.io/instance: {{ ollama_release_name }}
        app.kubernetes.io/part-of: fortiaigate-demo
    spec:
      restartPolicy: Never
      containers:
        - name: model-pull
          image: "{{ ollama_image_repository }}:{{ ollama_image_tag }}"
          imagePullPolicy: {{ ollama_image_pull_policy }}
          command:
            - /bin/sh
            - -c
          args:
            - |
              set -eu
              export OLLAMA_HOST="http://{{ ollama_release_name }}.{{ ollama_namespace }}.svc.cluster.local:{{ ollama_service_port }}"
              for attempt in $(seq 1 120); do
                if ollama list >/dev/null 2>&1; then
                  break
                fi
                if [ "$attempt" = "120" ]; then
                  echo "Ollama API was not ready before timeout." >&2
                  exit 1
                fi
                sleep 5
              done
{% for model in ollama_models %}
              ollama pull {{ model | quote }}
{% endfor %}
              ollama list
          volumeMounts:
            - name: models
              mountPath: /root/.ollama
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: {{ ollama_release_name }}-models
