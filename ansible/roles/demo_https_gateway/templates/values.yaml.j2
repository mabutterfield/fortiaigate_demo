nameOverride: "{{ demo_https_gateway_release_name }}"

image:
  repository: "{{ demo_https_gateway_image_repository }}"
  tag: "{{ demo_https_gateway_image_tag }}"
  pullPolicy: "{{ demo_https_gateway_image_pull_policy }}"

resolver: "{{ demo_https_gateway_resolver }}"

tls:
  cert: |
{{ demo_https_gateway_cert_content | indent(4, true) }}
  key: |
{{ demo_https_gateway_key_content | indent(4, true) }}

routes:
{% for route in demo_https_gateway_routes %}
  - name: "{{ route.name }}"
    displayName: "{{ route.display_name | default(route.name) }}"
    externalPort: {{ route.external_port }}
{% if route.plain_port | default('') | string | length > 0 %}
    plainPort: {{ route.plain_port }}
{% endif %}
    auth: {{ (route.auth | default(false) | bool) | ternary('true', 'false') }}
    upstream: "{{ route.upstream | trim }}"
{% if route.prefix_routes | default([]) | length > 0 %}
    prefixRoutes:
{% for prefix in route.prefix_routes %}
      - path: {{ prefix.path | to_json }}
        upstream: {{ prefix.upstream | trim | to_json }}
{% endfor %}
{% endif %}
{% endfor %}

labAuth:
  enabled: {{ (lab_gateway_enabled | bool) | ternary('true', 'false') }}
  image:
    repository: python
    tag: "3.12-slim"
  port: {{ lab_gateway_auth_port }}
  faigUrl: {{ lab_gateway_faig_url | to_json }}
  faigVerifyTls: {{ (lab_gateway_faig_verify_tls | bool) | ternary('true', 'false') }}
  httpsPort: {{ demo_https_gateway_chatbot_https_port }}
  maxSessionHours: {{ lab_gateway_max_session_hours }}
  idleMinutes: {{ lab_gateway_idle_minutes }}
  mode: {{ lab_gateway_mode | to_json }}
  signingSecretName: {{ lab_gateway_signing_secret_name | to_json }}
  fallbackSecretName: {{ lab_gateway_fallback_secret_name | to_json }}

