<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ demo_home_page_title }}</title>
  <style>
    :root {
      color-scheme: light;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f6f7f9;
      color: #1f2933;
    }
    body {
      margin: 0;
      padding: 32px;
    }
    main {
      max-width: 1280px;
      margin: 0 auto;
    }
    h1 {
      margin: 0 0 8px;
      font-size: 30px;
      font-weight: 700;
    }
    .subtle {
      margin: 0 0 28px;
      color: #5c6670;
    }
    section {
      margin: 28px 0;
    }
    h2 {
      margin: 0 0 12px;
      font-size: 18px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }
    a.card {
      display: block;
      min-height: 86px;
      padding: 14px 16px;
      border: 1px solid #d8dee4;
      border-radius: 6px;
      background: #ffffff;
      color: #1f2933;
      text-decoration: none;
    }
    a.card:hover {
      border-color: #2b6cb0;
    }
    .label {
      display: block;
      font-weight: 650;
      margin-bottom: 8px;
    }
    .meta,
    .url {
      display: block;
      color: #5c6670;
      font-size: 13px;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .meta {
      margin-bottom: 2px;
    }
{% if demo_home_extra_css | default('', true) | length > 0 %}
{{ demo_home_extra_css }}
{% endif %}
  </style>
</head>
<body>
{% macro link_card(link) -%}
        <a class="card" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
          <span class="label">{{ link.title | default(link.label) }}</span>
{% if link.transport | default('', true) | length > 0 %}
          <span class="meta">via {{ link.transport }}</span>
{% endif %}
          <span class="url">{{ link.url }}</span>
        </a>
{%- endmacro %}
  <main>
    <h1>{{ demo_home_page_title }}</h1>
    <p class="subtle">{{ demo_home_subtitle }}</p>

{% if demo_home_admin_links | length > 0 %}
    <section>
      <h2>{{ demo_home_section_titles.admin | default('Fortinet Admin') }}</h2>
      <div class="grid">
{% for link in demo_home_admin_links %}
{{ link_card(link) }}
{% endfor %}
      </div>
    </section>
{% endif %}

{% if demo_home_litellm_links | length > 0 %}
    <section>
      <h2>{{ demo_home_section_titles.litellm | default('LiteLLM') }}</h2>
      <div class="grid">
{% for link in demo_home_litellm_links %}
{{ link_card(link) }}
{% endfor %}
      </div>
    </section>
{% endif %}

{% if demo_home_mcp_direct_links | length > 0 %}
    <section>
      <h2>{{ demo_home_section_titles.mcp | default('MCP Tools') }}</h2>
      <div class="grid">
{% for link in demo_home_mcp_direct_links %}
{{ link_card(link) }}
{% endfor %}
      </div>
    </section>
{% endif %}

{% if demo_home_mcp_fortiweb_links | length > 0 %}
    <section>
      <h2>{{ demo_home_section_titles.mcp_fortiweb | default('MCP Tools (FortiWeb)') }}</h2>
      <div class="grid">
{% for link in demo_home_mcp_fortiweb_links %}
{{ link_card(link) }}
{% endfor %}
      </div>
    </section>
{% endif %}

{% if demo_home_links | length > 0 %}
    <section>
      <h2>{{ demo_home_section_titles.demo_home | default('Demo Home') }}</h2>
      <div class="grid">
{% for link in demo_home_links %}
{{ link_card(link) }}
{% endfor %}
      </div>
    </section>
{% endif %}

{% if demo_home_openwebui_links | length > 0 %}
    <section>
      <h2>{{ demo_home_section_titles.openwebui | default('Open WebUI') }}</h2>
      <div class="grid">
{% for link in demo_home_openwebui_links %}
{{ link_card(link) }}
{% endfor %}
      </div>
    </section>
{% endif %}

{% if demo_home_chatbot_links | length > 0 %}
    <section>
      <h2>{{ demo_home_section_titles.chatbot | default('FortiAIGate Demo Chatbot') }}</h2>
      <div class="grid">
{% for link in demo_home_chatbot_links %}
{{ link_card(link) }}
{% endfor %}
      </div>
    </section>
{% endif %}
  </main>
</body>
</html>
